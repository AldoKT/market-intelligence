{
  "name": "signal-frontend-v1",
  "private": true,
  "version": "2.1.0-candidate",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:pilot": "node tests/pilot-ui.cjs",
    "test:broker": "node tests/broker-ui.cjs",
    "test:gallery": "node tests/gallery.cjs",
    "test:market-activity": "node tests/market-activity.cjs",
    "test:broker-flow": "node tests/broker-flow.cjs",
    "build:pages": "tsc -b && vite build --config vite.config.ts --mode pages && python ../research/export_static_demo.py --output dist/data",
    "test:static": "node tests/static-demo.cjs",
    "preview:pages": "vite preview --config vite.config.ts --mode pages --host 127.0.0.1"
  },
  "dependencies": {
    "@liqui-design/glass": "^0.4.0",
    "lightweight-charts": "^5.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
